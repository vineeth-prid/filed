# backend/.env.example — copy to .env and fill in real values before starting the server.

# ---- Required ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=filed

# At least 32 characters in production. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-32-char-string-minimum

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Optional ----

# LLM key for the /api/insights endpoint (Emergent platform key)
EMERGENT_LLM_KEY=

# Comma-separated list of allowed frontend origins, e.g.:
#   CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Leave blank in development (wildcard mode, credentials-less CORS).
CORS_ORIGINS=

# Set to "production" to enforce strict JWT secret length and closed-CORS defaults.
ENVIRONMENT=development

# Rate limiting overrides (defaults shown)
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60
# INSIGHTS_RATE_LIMIT_REQUESTS=5
# INSIGHTS_RATE_LIMIT_WINDOW_SECONDS=60

# Insights input caps
# INSIGHTS_MAX_COLLEGES=8
# INSIGHTS_MAX_FIELD_LEN=120
