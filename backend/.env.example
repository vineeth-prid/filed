# backend/.env.example — copy to .env and fill in real values before starting the server.

# ---- Required ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=filed

# At least 32 characters in production. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-32-char-string-minimum

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Local LLM (Ollama) ----
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull model: ollama pull llama3.2
# Ollama listens on port 11434 by default.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# ---- Field-level encryption for sensitive DB data ----
# Generate a Fernet key (do this ONCE, back it up securely — losing it = losing data):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to disable field encryption (not recommended for production).
DB_ENCRYPTION_KEY=

# ---- CORS ----
# Comma-separated list of allowed frontend origins (no trailing slash), e.g.:
#   CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Leave blank in development (wildcard mode, Bearer-in-header auth, no cookies).
CORS_ORIGINS=

# ---- Environment ----
# Set to "production" to enforce: strict JWT length, HSTS headers, closed CORS,
# hidden /docs endpoint, and HTTPS redirect.
ENVIRONMENT=development

# ---- Rate limiting (defaults shown, uncomment to override) ----
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60
# INSIGHTS_RATE_LIMIT_REQUESTS=5
# INSIGHTS_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Brute-force login protection ----
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900

# ---- Request safety ----
# MAX_REQUEST_BODY_BYTES=65536
# REQUEST_TIMEOUT_SECONDS=30
# LLM_TIMEOUT_SECONDS=150

# ---- Insights input caps ----
# INSIGHTS_MAX_COLLEGES=8
# INSIGHTS_MAX_FIELD_LEN=120
